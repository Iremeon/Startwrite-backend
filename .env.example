# ── App ──
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ── Database ──
DATABASE_URL="postgresql://user:password@localhost:5432/startwrite?schema=public"

# ── Redis (verification tokens + refresh tokens) ──
REDIS_URL="redis://localhost:6379"

# ── JWT ──
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# ── Email verification ──
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600

# ── SendGrid ──
SENDGRID_API_KEY=replace_with_sendgrid_api_key
SENDGRID_FROM_EMAIL=no-reply@startwrite.com
FRONTEND_URL=http://localhost:3000

# ── Google OAuth ──
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# ── Seed data ──
ADMIN_FULL_NAME="Startwrite Admin"
ADMIN_EMAIL=admin@startwrite.com
ADMIN_PASSWORD=ChangeMe123!

# ── Stripe (one-time wallet top-up payments — no subscriptions) ──
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
